{
  "name": "solana-clear-sign",
  "version": "0.1.0",
  "description": "Defensive sRFC 39 clear-signing reference engine and conformance suite",
  "author": "Elyzion, Inc.",
  "homepage": "https://github.com/mjordan237/solana-clear-sign#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjordan237/solana-clear-sign.git"
  },
  "bugs": {
    "url": "https://github.com/mjordan237/solana-clear-sign/issues"
  },
  "keywords": ["solana", "clear-signing", "srfc39", "wallet-security", "anchor", "borsh"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "solana-clear-sign-lint": "dist/cli/index.js" },
  "files": ["dist", "README.md", "LICENSE", "NOTICE", "SECURITY.md", "SPECIFICATION.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && c8 --reporter=text --reporter=json-summary --all --include='.test-dist/src/**/*.js' --exclude='.test-dist/src/cli/**' node --test .test-dist/test/*.test.js",
    "test:watch": "npm run build:test && node --test --watch .test-dist/test/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "bench": "npm run build:test && node --test .test-dist/test/benchmark.test.js",
    "spec:verify": "node scripts/verify-spec-pin.mjs",
    "vectors:materialize": "node scripts/materialize-vectors.mjs",
    "vectors:verify": "node scripts/materialize-vectors.mjs --check"
  },
  "engines": { "node": ">=18" },
  "license": "Apache-2.0",
  "dependencies": { "zod": "^3.25.76" },
  "devDependencies": {
    "@types/node": "^20.19.14",
    "c8": "^10.1.3",
    "typescript": "^5.9.2"
  }
}
